# Secrets / config
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/

# Episode records ARE tracked in git (no secrets in them) so the monthly cloud
# job can see your episodes and update their analytics. Comment the next two
# lines back in if you'd rather keep episodes local-only.
#   data/episodes/*
#   !data/episodes/.gitkeep

# Raw analytics exports (e.g. Apple CSVs) stay local.
data/analytics/*
!data/analytics/.gitkeep

# Regenerable generated content (blogs/social/prompts) stays local.
data/output/*
!data/output/.gitkeep

# OAuth tokens / secrets folder — never commit.
secrets/

# OS
.DS_Store
