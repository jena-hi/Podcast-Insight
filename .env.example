# ─── Podcast Insight configuration ───────────────────────────────────────────
# Copy this file to ".env" and fill in what you have. Anything left blank just
# means that feature runs in "dry-run" mode or is skipped. Nothing here is
# committed to git (.env is ignored).

# ── AI content generation (Claude) ───────────────────────────────────────────
# Get a key at https://console.anthropic.com  (API Keys). Leave blank to run in
# dry-run mode, which writes prompts to files instead of calling the API.
ANTHROPIC_API_KEY=

# ── YouTube analytics ────────────────────────────────────────────────────────
# See docs/CONNECTING_ANALYTICS.md for how to create these in Google Cloud.
# Level 1 — public stats (views/likes/comments): just an API key.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
# Level 2 — private analytics (watch time, retention, subs). Run
# `podcast-insight auth youtube` once with the client-secret file below; it saves
# a token locally AND prints a refresh token to store as a secret for the cloud job.
YOUTUBE_OAUTH_CLIENT_SECRET_FILE=secrets/yt_client_secret.json
# These three are the headless credentials (used by GitHub Actions). The refresh
# token is printed by `auth youtube`. Locally you can leave them blank.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=

# ── Spotify for Creators (UNOFFICIAL pull) ───────────────────────────────────
# Spotify has no official analytics API, so this reuses your logged-in session.
# It's undocumented and a gray area vs. Spotify's terms — it can break anytime.
# See docs/CONNECTING_ANALYTICS.md for exactly how to grab these.
#   sp_dc cookie from your browser (lasts ~1 year):
SPOTIFY_DC_COOKIE=
SPOTIFY_SHOW_ID=
#   One analytics request URL captured from the dashboard's Network tab. May use
#   {episode_id} and {show_id} placeholders, e.g.
#   https://.../shows/{show_id}/episodes/{episode_id}/detailedStreams
SPOTIFY_CREATORS_ANALYTICS_URL=
#   Optional: comma-separated JSON keys to read as 'listens' (else auto-detected).
SPOTIFY_CREATORS_METRIC_KEYS=

# ── TikTok voiceover (OPTIONAL, paid) ────────────────────────────────────────
# Only needed if you want AI voiceover AUDIO on the TikToks. The voiceover SCRIPT
# is always generated for free; this turns it into an mp3. There's no free
# Anthropic TTS, so this uses any OpenAI-compatible /audio/speech endpoint. Leave
# blank to skip audio (use the script, record it yourself, or have Canva read it).
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# ── Apple Podcasts ───────────────────────────────────────────────────────────
# Apple analytics come from Apple Podcasts Connect (no open public API). The
# connector reads a CSV export you download. Point it at the folder you save to.
APPLE_PODCASTS_EXPORT_DIR=data/analytics/apple_exports
